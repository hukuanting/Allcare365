# Inject real values through the platform secret manager; do not source this file.
DJANGO_SETTINGS_MODULE=medical_system.settings_production
SECRET_KEY=<random-secret-at-least-50-characters>
PUBLIC_BASE_URL=https://api.example.org
ALLOWED_HOSTS=api.example.org
CSRF_TRUSTED_ORIGINS=https://app.example.org,https://api.example.org
CORS_ALLOWED_ORIGINS=https://app.example.org
DATABASE_URL=postgresql://app:<secret>@db.internal:5432/allcare365?sslmode=verify-full
OIDC_RSA_PRIVATE_KEY=<dedicated-unencrypted-RSA-2048+-PEM-private-key>
CACHE_URL=rediss://cache.internal:6379/0
PRIVATE_STORAGE_BACKEND=s3
PRIVATE_STORAGE_BUCKET=<private-bucket-name>
PRIVATE_STORAGE_REGION=<region>
BULK_EXPORT_TTL_SECONDS=86400
VITE_API_URL=https://api.example.org
