# Non-secret Cloud Run environment values. Replace placeholders before deploy.
DJANGO_SETTINGS_MODULE=medical_system.settings_production
PUBLIC_BASE_URL=https://<cloud-run-api-url>
ALLOWED_HOSTS=<cloud-run-api-host>
CSRF_TRUSTED_ORIGINS=https://<cloud-run-api-host>,https://<firebase-project-id>.web.app
CORS_ALLOWED_ORIGINS=https://<firebase-project-id>.web.app

# Store DATABASE_URL and OIDC_RSA_PRIVATE_KEY as Secret Manager secrets.
# Cloud Run's Cloud SQL integration exposes this authenticated socket path.
# URL-encode the password and the ':' characters in the connection name.
DATABASE_URL=postgresql://app:<url-encoded-password>@localhost:5432/allcare365?host=%2Fcloudsql%2F<project-id>%3Aasia-east1%3A<instance-name>

# Set this to the Memorystore TLS address and mount its CA certificate as a
# Secret Manager volume at /secrets/redis/ca.pem.
CACHE_URL=rediss://<memorystore-private-ip>:6378/0
CACHE_TLS_CA_CERT=/secrets/redis/ca.pem

PRIVATE_STORAGE_BACKEND=gcs
PRIVATE_STORAGE_BUCKET=<private-bucket-name>
BULK_EXPORT_TTL_SECONDS=86400
