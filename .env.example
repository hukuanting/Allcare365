# Local development only. Never commit a real .env file.
SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=True
DB_NAME=allcare365
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FHIR_ALLOW_ANONYMOUS_READ=False

# SMART/OIDC signing key. Inject a unique PEM private key through the secret
# manager. Escaped newlines (\\n) are accepted. Never commit the real value.
OIDC_RSA_PRIVATE_KEY=

# Frontend local setting lives in frontend/.env.local; this file is for Django.

# Optional trusted origins for manual FHIR REST import (comma separated).
# Empty disables REST fetching; DEBUG defaults to local port 8000 when unset.
FHIR_IMPORT_ALLOWED_ORIGINS=
